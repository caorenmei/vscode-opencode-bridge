{
  "name": "vscode-opencode-bridge",
  "version": "0.0.1",
  "private": true,
  "description": "Workspace root for the VS Code extension and the opencode TUI plugin.",
  "scripts": {
    "build": "tsc -p extension/tsconfig.json",
    "watch": "tsc -w -p extension/tsconfig.json",
    "check": "tsc -p extension/tsconfig.json --noEmit && tsc -p tui-plugin/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0"
  }
}
